# Copy to .env and fill in your values before running locally

# Authentication
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank to disable auth in local dev (NOT safe for production)
API_KEY=

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Vector store backend: "opensearch" (default) or "pgvector"
VECTOR_BACKEND=opensearch

# OpenSearch
OPENSEARCH_HOST=your-opensearch-domain.us-east-1.es.amazonaws.com
OPENSEARCH_USER=
OPENSEARCH_PASS=
VECTOR_INDEX_NAME=visual-project-intelligence

# pgvector (only needed if VECTOR_BACKEND=pgvector)
PGVECTOR_DSN=postgresql://user:pass@host:5432/dbname

# DynamoDB (optional — written by Lambda ingestion function)
PHOTO_TABLE_NAME=
