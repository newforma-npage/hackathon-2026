# Copy to .env and fill in your values before running locally

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OpenSearch — must match the ingestion backend (app/backend/vector_store.py)
OPENSEARCH_HOST=your-opensearch-domain.us-east-1.es.amazonaws.com
OPENSEARCH_PORT=443
# OPENSEARCH_INDEX and VECTOR_INDEX_NAME both default to "visual-project-intelligence"
# Override here only if you changed the index name during ingestion
VECTOR_INDEX_NAME=visual-project-intelligence
